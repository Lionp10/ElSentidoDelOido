@model ElSentidoDelOido.Web.Models.ShiftIndexViewModel

@{
    ViewData["Title"] = "Solicitar Turno Online";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    :root {
        --color-primary: #16255b;
        --color-secondary: #02205C;
        --color-accent: #FFB81C;
        --color-light-bg: #F5F7FA;
        --color-success: #10B981;
        --color-error: #EF4444;
        --color-warning: #F59E0B;
    }

    .shift-container {
        background: linear-gradient(135deg, rgba(22, 37, 91, 0.05) 0%, rgba(255, 184, 28, 0.03) 100%);
        min-height: 100vh;
        padding: 40px 0;
    }

    .shift-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(22, 37, 91, 0.1);
        overflow: hidden;
    }

    .stepper {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 30px;
        background: white;
        border-bottom: 2px solid var(--color-light-bg);
    }

    .stepper-item {
        flex: 1;
        display: flex;
        align-items: center;
        position: relative;
    }

        .stepper-item:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100%;
            height: 2px;
            background-color: var(--color-light-bg);
            transform: translateY(-50%);
            z-index: -1;
        }

        .stepper-item.active:not(:last-child)::after {
            background-color: var(--color-primary);
        }

    .stepper-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: var(--color-light-bg);
        border: 3px solid var(--color-light-bg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        color: #666;
        transition: all 0.3s ease;
        flex-shrink: 0;
    }

    .stepper-item.active .stepper-circle {
        background-color: var(--color-primary);
        border-color: var(--color-primary);
        color: white;
        box-shadow: 0 4px 12px rgba(22, 37, 91, 0.3);
    }

    .stepper-item.completed .stepper-circle {
        background-color: var(--color-success);
        border-color: var(--color-success);
        color: white;
    }

        .stepper-item.completed .stepper-circle::after {
            content: '✓';
        }

    .stepper-label {
        margin-left: 15px;
        font-weight: 500;
        color: #999;
        font-size: 14px;
    }

    .stepper-item.active .stepper-label {
        color: var(--color-primary);
        font-weight: 600;
    }

    .step-content {
        display: none;
        padding: 40px;
        animation: fadeIn 0.3s ease;
    }

        .step-content.active {
            display: block;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .form-control-shift {
        border: 1px solid #E5E7EB;
        border-radius: 8px;
        padding: 12px 15px;
        font-size: 14px;
        transition: all 0.3s ease;
    }

        .form-control-shift:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(22, 37, 91, 0.1);
            outline: none;
        }

        .form-control-shift::placeholder {
            color: #999;
        }

    .turno-card {
        border: 2px solid #E5E7EB;
        border-radius: 10px;
        padding: 20px;
        cursor: pointer;
        transition: all 0.3s ease;
        background: white;
        margin-bottom: 15px;
    }

        .turno-card:hover {
            border-color: var(--color-primary);
            box-shadow: 0 4px 12px rgba(22, 37, 91, 0.1);
        }

        .turno-card.selected {
            border-color: var(--color-primary);
            background-color: rgba(22, 37, 91, 0.05);
            box-shadow: 0 4px 12px rgba(22, 37, 91, 0.15);
        }

        .turno-card input[type="radio"] {
            margin-right: 15px;
            accent-color: var(--color-primary);
            cursor: pointer;
        }

    .turno-card-text {
        color: #1F2937;
        font-weight: 500;
    }

    .calendar-input {
        accent-color: var(--color-primary);
    }

    .fecha-no-disponible {
        background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
        border: 1px solid #F59E0B;
        border-radius: 8px;
        padding: 15px;
        margin-top: 15px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .fecha-no-disponible i {
            color: var(--color-warning);
            font-size: 18px;
        }

        .fecha-no-disponible .mensaje {
            color: #92400E;
            font-weight: 500;
            font-size: 14px;
        }

    .horarios-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
        gap: 10px;
        margin-top: 15px;
    }

    .horario-btn {
        padding: 12px;
        border: 2px solid #E5E7EB;
        background: white;
        border-radius: 8px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 500;
        transition: all 0.3s ease;
        color: #1F2937;
    }

        .horario-btn:hover:not(:disabled) {
            border-color: var(--color-primary);
            color: var(--color-primary);
        }

        .horario-btn.selected {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
            color: white;
        }

        .horario-btn:disabled {
            background-color: #F3F4F6;
            border-color: #D1D5DB;
            color: #9CA3AF;
            cursor: not-allowed;
        }

    .input-group-shift {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }

        .input-group-shift label {
            font-weight: 600;
            color: #1F2937;
            font-size: 14px;
        }

        .input-group-shift.full {
            grid-column: 1 / -1;
        }

    .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
    }

        .form-grid .input-group-shift.full {
            grid-column: 1 / -1;
        }

    .button-group {
        display: flex;
        gap: 10px;
        margin-top: 30px;
        justify-content: space-between;
        padding: 0 32px; 
        align-items: center;
    }

    .button-group.align-right {
        justify-content: flex-end;
    }

    .btn-shift {
        padding: 12px 30px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .btn-shift-primary {
        background-color: var(--color-primary);
        color: white;
    }

        .btn-shift-primary:hover {
            background-color: var(--color-secondary);
            box-shadow: 0 4px 12px rgba(22, 37, 91, 0.3);
        }

    .btn-shift-secondary {
        background-color: transparent;
        color: var(--color-primary);
        border: 2px solid var(--color-primary);
    }

        .btn-shift-secondary:hover {
            background-color: rgba(22, 37, 91, 0.05);
        }

    .btn-shift:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .button-group.align-right .btn-shift + .btn-shift {
        margin-left: 12px;
    }

    .error-message {
        color: var(--color-error);
        font-size: 12px;
        margin-top: 5px;
    }

    .input-group-shift.error .form-control-shift {
        border-color: var(--color-error);
    }

    .resumen-card {
        background: rgba(22, 37, 91, 0.05);
        border-left: 4px solid var(--color-primary);
        padding: 15px;
        border-radius: 6px;
        margin-bottom: 20px;
    }

    .resumen-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        font-size: 14px;
    }

    .resumen-item-label {
        color: #666;
        font-weight: 500;
    }

    .resumen-item-value {
        color: var(--color-primary);
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .stepper {
            padding: 12px 16px;
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 12px;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            justify-content: flex-start;
            background: white;
        }

        .stepper-item {
            flex: 0 0 auto;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            margin-right: 12px;
            min-width: 56px; 
        }

            .stepper-item:not(:last-child)::after {
                display: none;
            }

        .step-content {
            padding: 20px;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }

        .horarios-grid {
            grid-template-columns: repeat(auto-fill, minmax(75px, 1fr));
        }

        .button-group {
            flex-direction: column;
            padding: 0 16px 24px 16px;
            align-items: stretch;
        }

        .button-group .btn-shift {
            width: 100%;
        }

        .stepper-label {
            display: none;
        }

        .button-group.align-right {
            justify-content: flex-end; 
        }
    }
</style>

<div class="shift-container">
    <div class="container">
        <div class="shift-card">

            <div class="stepper">
                <div class="stepper-item active" data-step="1">
                    <div class="stepper-circle">1</div>
                    <div class="stepper-label">Tipo de Turno</div>
                </div>
                <div class="stepper-item" data-step="2">
                    <div class="stepper-circle">2</div>
                    <div class="stepper-label">Fecha y Hora</div>
                </div>
                <div class="stepper-item" data-step="3">
                    <div class="stepper-circle">3</div>
                    <div class="stepper-label">Datos Personales</div>
                </div>
            </div>

            <form id="formularioTurno" method="POST" action="@Url.Action("SaveTurn", "Shift")">
                @Html.AntiForgeryToken()
  
                <input type="hidden" id="tipoTurnoIdHidden" name="TipoTurnoId" value="" />

                <div class="step-content active" data-step="1">
                    <h4 class="mb-4" style="color: var(--color-primary); font-weight: 600;">
                        <i class="bi bi-stethoscope"></i> Selecciona el tipo de turno
                    </h4>

                    <div id="tiposTurnoContainer">
                        @foreach (var tipo in Model.TiposTurnos)
                        {
                            <label class="turno-card">
                                <input type="radio" name="TipoTurnoRadio" value="@tipo.Id" class="turno-selector" />
                                <span class="turno-card-text">@tipo.Name</span>
                            </label>
                        }
                    </div>
                    <span id="errorTipo" class="error-message"></span>
                </div>

                <div class="step-content" data-step="2">
                    <h4 class="mb-4" style="color: var(--color-primary); font-weight: 600;">
                        <i class="bi bi-calendar-event"></i> Selecciona fecha y hora
                    </h4>

                    <div class="form-grid">
                        <div class="input-group-shift">
                            <label for="fecha">Fecha</label>
                            <input type="date" id="fecha" name="Date" class="form-control-shift calendar-input" required />
                            <span id="errorFecha" class="error-message"></span>
                        </div>
                    </div>

                    <div id="fechaNoDisponible" class="fecha-no-disponible" style="display: none;">
                        <i class="bi bi-exclamation-triangle"></i>
                        <div class="mensaje" id="mensajeFechaNoDisponible">
                            Selecciona otra fecha, no hay turnos disponibles para el día seleccionado.
                        </div>
                    </div>

                    <div>
                        <label style="font-weight: 600; color: #1F2937; font-size: 14px; display: block; margin-bottom: 15px;">
                            <i class="bi bi-clock"></i> Horarios disponibles
                        </label>
                        <div class="horarios-grid" id="horariosContainer">
                            <p style="color: #999; font-size: 14px;">Selecciona una fecha para ver horarios disponibles</p>
                        </div>
                        <span id="errorHora" class="error-message"></span>
                    </div>
                    <input type="hidden" id="horaSeleccionada" name="Hour" />
                </div>

                <div class="step-content" data-step="3">
                    <h4 class="mb-4" style="color: var(--color-primary); font-weight: 600;">
                        <i class="bi bi-person-check"></i> Completa tus datos personales
                    </h4>

                    <div class="resumen-card">
                        <div class="resumen-item">
                            <span class="resumen-item-label">Tipo de Turno:</span>
                            <span class="resumen-item-value" id="resumenTipo">-</span>
                        </div>
                        <div class="resumen-item">
                            <span class="resumen-item-label">Fecha:</span>
                            <span class="resumen-item-value" id="resumenFecha">-</span>
                        </div>
                        <div class="resumen-item">
                            <span class="resumen-item-label">Hora:</span>
                            <span class="resumen-item-value" id="resumenHora">-</span>
                        </div>
                    </div>

                    <div class="form-grid">
                        <div class="input-group-shift">
                            <label for="nombre">Nombre</label>
                            <input type="text" id="nombre" name="FirstName" class="form-control-shift" placeholder="Tu nombre" required />
                            <span id="errorNombre" class="error-message"></span>
                        </div>

                        <div class="input-group-shift">
                            <label for="apellido">Apellido</label>
                            <input type="text" id="apellido" name="LastName" class="form-control-shift" placeholder="Tu apellido" required />
                            <span id="errorApellido" class="error-message"></span>
                        </div>

                        <div class="input-group-shift">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="Email" class="form-control-shift" placeholder="tu@email.com" required />
                            <span id="errorEmail" class="error-message"></span>
                        </div>

                        <div class="input-group-shift">
                            <label for="telefono">Teléfono</label>
                            <input type="tel" id="telefono" name="Phone" class="form-control-shift" placeholder="+54 3464 123456" required />
                            <span id="errorTelefono" class="error-message"></span>
                        </div>

                        <div class="input-group-shift full">
                            <label for="mensaje">Mensaje (Opcional)</label>
                            <textarea id="mensaje" name="Message" class="form-control-shift" placeholder="Comparte cualquier información adicional..." rows="4"></textarea>
                        </div>
                    </div>
                </div>

                <div class="button-group mb-4">
                    <button type="button" id="btnAnterior" class="btn-shift btn-shift-secondary" style="display: none;">
                        <i class="bi bi-arrow-left"></i> Anterior
                    </button>
                    <button type="button" id="btnSiguiente" class="btn-shift btn-shift-primary">
                        Siguiente <i class="bi bi-arrow-right"></i>
                    </button>
                    <button type="submit" id="btnEnviar" class="btn-shift btn-shift-primary" style="display: none;">
                        <i class="bi bi-check-circle"></i> Confirmar Turno
                    </button>
                </div>
            </form>

        </div>
    </div>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    $(document).ready(function () {
        let pasoActual = 1;
        const totalPasos = 3;
        const formulario = $('#formularioTurno');
        let feriadosDelMes = [];

        function actualizarStepper() {
            $('.stepper-item').each(function () {
                const paso = $(this).data('step');
                $(this).removeClass('active completed');

                if (paso < pasoActual) {
                    $(this).addClass('completed');
                } else if (paso === pasoActual) {
                    $(this).addClass('active');
                }
            });

            $('.step-content').removeClass('active');
            $(`.step-content[data-step="${pasoActual}"]`).addClass('active');

            $('#btnAnterior').toggle(pasoActual > 1);
            $('#btnSiguiente').toggle(pasoActual < totalPasos);
            $('#btnEnviar').toggle(pasoActual === totalPasos);

            if (pasoActual === 1) {
                $('.button-group').addClass('align-right');
            } else {
                $('.button-group').removeClass('align-right');
            }
        }

        function deshabilitarFechasNoDisponibles() {
            const fechaInput = document.getElementById('fecha');
            if (!fechaInput) return;

            fechaInput.addEventListener('input', function(e) {
                const fechaSeleccionada = new Date(e.target.value + 'T00:00:00');
                const diaSemana = fechaSeleccionada.getDay();

                if (diaSemana === 0 || diaSemana === 6) {
                    mostrarMensajeFechaNoDisponible('Los consultorios permanecen cerrados los fines de semana.');
                    e.target.value = '';
                    return;
                }

                const dia = fechaSeleccionada.getDate();
                if (feriadosDelMes.includes(dia)) {
                    mostrarMensajeFechaNoDisponible('No hay horarios disponibles para este día.');
                    e.target.value = '';
                    return;
                }

                ocultarMensajeFechaNoDisponible();
            });
        }

        function mostrarMensajeFechaNoDisponible(mensaje) {
            $('#mensajeFechaNoDisponible').text(mensaje);
            $('#fechaNoDisponible').slideDown(300);
            $('#horariosContainer').html('<p style="color: #999; font-size: 14px;">Selecciona una fecha válida para ver horarios disponibles</p>');
            $('#horaSeleccionada').val('');
        }

        function ocultarMensajeFechaNoDisponible() {
            $('#fechaNoDisponible').slideUp(300);
        }

        async function cargarFeriadosDelMes(fecha) {
            const date = new Date(fecha);
            const year = date.getFullYear();
            const month = date.getMonth() + 1;

            try {
                const response = await $.ajax({
                    url: '@Url.Action("ObtenerFeriadosDelMes", "Shift")',
                    type: 'GET',
                    data: { year: year, month: month }
                });
                feriadosDelMes = response || [];
            } catch (error) {
                console.error('Error al cargar feriados:', error);
                feriadosDelMes = [];
            }
        }

        function cargarHorarios() {
            const tipoTurnoId = $('#tipoTurnoIdHidden').val();
            const fecha = $('#fecha').val();

            if (!tipoTurnoId || !fecha) {
                $('#horariosContainer').html('<p style="color: #999; font-size: 14px;">Selecciona una fecha para ver horarios disponibles</p>');
                return;
            }

            $.ajax({
                url: '@Url.Action("ObtenerHorarios", "Shift")',
                type: 'GET',
                data: { tipoTurnoId: tipoTurnoId, fecha: fecha },
                success: function (data) {
                    if (data.esFinDeSemana || data.esFeriado) {
                        mostrarMensajeFechaNoDisponible(data.mensaje);
                        return;
                    }

                    ocultarMensajeFechaNoDisponible();
                    
                    let html = '';
                    
                    if (Array.isArray(data)) {
                        if (data.length === 0) {
                            html = '<p style="color: #999; font-size: 14px;">No hay horarios disponibles para este día</p>';
                        } else {
                            data.forEach(function (horario) {
                                const disabled = !horario.disponible ? 'disabled' : '';
                                html += `<button type="button" class="horario-btn" data-hora="${horario.hora}" ${disabled}>${horario.hora}</button>`;
                            });
                        }
                    } else {
                        html = '<p style="color: #999; font-size: 14px;">No hay horarios disponibles para este día</p>';
                        console.warn('Respuesta inesperada del servidor:', data);
                    }
                    
                    $('#horariosContainer').html(html);

                    const horaSeleccionada = $('#horaSeleccionada').val();
                    if (horaSeleccionada) {
                        $(`.horario-btn[data-hora="${horaSeleccionada}"]`).addClass('selected');
                    }
                },
                error: function(xhr, status, error) {
                    console.error('Error en AJAX:', error);
                    mostrarMensajeFechaNoDisponible('Error al cargar los horarios. Intenta nuevamente.');
                }
            });
        }

        function validarPaso() {
            let esValido = true;

            if (pasoActual === 1) {
                if (!$('#tipoTurnoIdHidden').val()) {
                    $('#errorTipo').text('Debes seleccionar un tipo de turno');
                    esValido = false;
                } else {
                    $('#errorTipo').text('');
                }
            } else if (pasoActual === 2) {
                if (!$('#fecha').val()) {
                    $('#errorFecha').text('Debes seleccionar una fecha');
                    esValido = false;
                } else {
                    $('#errorFecha').text('');
                }

                if (!$('#horaSeleccionada').val()) {
                    $('#errorHora').text('Debes seleccionar una hora');
                    esValido = false;
                } else {
                    $('#errorHora').text('');
                }
            } else if (pasoActual === 3) {
                if (!$('#nombre').val()) {
                    $('#errorNombre').text('El nombre es requerido');
                    esValido = false;
                } else {
                    $('#errorNombre').text('');
                }
                if (!$('#apellido').val()) {
                    $('#errorApellido').text('El apellido es requerido');
                    esValido = false;
                } else {
                    $('#errorApellido').text('');
                }
                if (!$('#email').val()) {
                    $('#errorEmail').text('El email es requerido');
                    esValido = false;
                } else {
                    $('#errorEmail').text('');
                }
                if (!$('#telefono').val()) {
                    $('#errorTelefono').text('El teléfono es requerido');
                    esValido = false;
                } else {
                    $('#errorTelefono').text('');
                }
            }

            return esValido;
        }

        function actualizarResumen() {
            const tipoTurnoId = $('#tipoTurnoIdHidden').val();
            const tipoTurnoNombre = $(`input[name="TipoTurnoRadio"][value="${tipoTurnoId}"]`).siblings('.turno-card-text').text() || '-';

            $('#resumenTipo').text(tipoTurnoNombre);
            
            const fechaValue = $('#fecha').val();
            if (fechaValue) {
                const fechaFormateada = new Date(fechaValue + 'T00:00:00').toLocaleDateString('es-AR');
                $('#resumenFecha').text(fechaFormateada);
            } else {
                $('#resumenFecha').text('-');
            }
            
            $('#resumenHora').text($('#horaSeleccionada').val() || '-');
        }

        $(document).on('change', 'input[name="TipoTurnoRadio"]', function () {
            $('.turno-card').removeClass('selected');
            $(this).closest('.turno-card').addClass('selected');

            $('#tipoTurnoIdHidden').val($(this).val());
            
            cargarHorarios();
        });

        $(document).on('change', '#fecha', async function () {
            const fecha = $(this).val();
            if (fecha) {
                await cargarFeriadosDelMes(fecha);
            }
            cargarHorarios();
        });

        $(document).on('click', '.horario-btn:not(:disabled)', function () {
            $('.horario-btn').removeClass('selected');
            $(this).addClass('selected');
            $('#horaSeleccionada').val($(this).data('hora'));
        });

        $('#btnSiguiente').click(function (e) {
            e.preventDefault();
            if (validarPaso()) {
                if (pasoActual < totalPasos) {
                    pasoActual++;
                    actualizarStepper();
                    if (pasoActual === 3) {
                        actualizarResumen();
                    }
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                }
            }
        });

        $('#btnAnterior').click(function (e) {
            e.preventDefault();
            if (pasoActual > 1) {
                pasoActual--;
                actualizarStepper();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        });

        $('#btnEnviar').click(function (e) {
            if (!validarPaso()) {
                e.preventDefault();
            }
        });

        actualizarStepper();
        deshabilitarFechasNoDisponibles();

        const hoy = new Date().toISOString().split('T')[0];
        $('#fecha').attr('min', hoy);
    });
</script>

