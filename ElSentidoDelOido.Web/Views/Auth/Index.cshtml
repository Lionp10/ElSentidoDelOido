@model ElSentidoDelOido.Negocio.DTOs.LoginDTO

@{
    ViewData["Title"] = "Inicio de Sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // URL objetivo del formulario de contacto en la vista principal (Home#Contacto)
    var contactUrl = Url.Action("Index", "Home") + "#Contacto";
}

<style>
    /* Estilos personalizados para el formulario de login */
    .login-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #16255b 0%, #1a2f73 100%);
        padding: 20px;
    }

    .login-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(22, 37, 91, 0.2);
        padding: 40px;
        max-width: 450px;
        width: 100%;
        animation: slideIn 0.6s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(30px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .login-header {
        text-align: center;
        margin-bottom: 30px;
    }

        .login-header h1 {
            color: #16255b;
            font-weight: 700;
            font-size: 28px;
            margin-bottom: 10px;
        }

        .login-header p {
            color: #666;
            font-size: 14px;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            color: #16255b;
            font-weight: 600;
            margin-bottom: 8px;
            font-size: 14px;
        }

        .form-group input {
            width: 100%;
            padding: 12px 15px;
            border: 2px solid #e0e0e0;
            border-radius: 6px;
            font-size: 14px;
            transition: all 0.3s ease;
            font-family: inherit;
        }

            .form-group input:focus {
                outline: none;
                border-color: #16255b;
                box-shadow: 0 0 0 3px rgba(22, 37, 91, 0.1);
            }

            .form-group input::placeholder {
                color: #999;
            }

    .input-icon {
        position: relative;
    }

        .input-icon i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #16255b;
            font-size: 16px;
        }

        .input-icon input {
            padding-left: 45px;
        }

    .btn-login {
        width: 100%;
        padding: 12px;
        background-color: #16255b;
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        margin-top: 10px;
    }

        .btn-login:hover {
            background-color: #0f1a3f;
            box-shadow: 0 5px 20px rgba(22, 37, 91, 0.3);
            transform: translateY(-2px);
        }

        .btn-login:active {
            transform: translateY(0);
        }

    .remember-forgot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        font-size: 13px;
    }

        .remember-forgot a {
            color: #16255b;
            text-decoration: none;
            transition: color 0.3s ease;
        }

            .remember-forgot a:hover {
                color: #1a2f73;
                text-decoration: underline;
            }

        .remember-forgot input[type="checkbox"] {
            width: auto;
            margin-right: 5px;
        }

    .alert {
        border-radius: 6px;
        margin-bottom: 20px;
        border: none;
    }

    .alert-danger {
        background-color: #fee;
        color: #c33;
        padding: 12px 15px;
    }

    .footer-login {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
        color: #666;
    }

        .footer-login a {
            color: #16255b;
            text-decoration: none;
            font-weight: 600;
        }

            .footer-login a:hover {
                text-decoration: underline;
            }

    .divider {
        text-align: center;
        margin: 20px 0;
        color: #ccc;
    }

        .divider::before {
            content: '';
            display: inline-block;
            width: 45%;
            border-top: 1px solid #e0e0e0;
            vertical-align: middle;
            margin-right: 10px;
        }

        .divider::after {
            content: '';
            display: inline-block;
            width: 45%;
            border-top: 1px solid #e0e0e0;
            vertical-align: middle;
            margin-left: 10px;
        }
</style>

<div class="login-container">
    <div class="login-card">
        <!-- Header -->
        <div class="login-header">
            <h1><i class="bi bi-lock-fill"></i> Iniciar Sesión</h1>
            <p>Panel Administrativo - El Sentido del Oído</p>
        </div>

        <!-- Mostrar errores si existen -->
        @if (ViewData.ModelState.Values.Any(x => x.Errors.Count > 0))
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i>
                @Html.ValidationSummary(true, "", new { @class = "mb-0" })
            </div>
        }

        <!-- Formulario de login -->
        @using (Html.BeginForm("Login", "Auth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3 d-none" }) @* summary adicional si se necesita *@

            <!-- Email -->
            <div class="form-group">
                @Html.LabelFor(m => m.Email)
                <div class="input-icon">
                    <i class="bi bi-envelope"></i>
                    @Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", placeholder = "tu@email.com", autocomplete = "email", id = "Email" })
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>
            </div>

            <!-- Contraseña -->
            <div class="form-group">
                @Html.LabelFor(m => m.Password)
                <div class="input-icon">
                    <i class="bi bi-lock"></i>
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Ingresa tu contraseña", autocomplete = "current-password", id = "Password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                </div>
            </div>

            <!-- Recordarme y olvide contraseña -->
            <div class="remember-forgot">
                <div>
                    @* Html.CheckBoxFor genera automáticamente el hidden necesario para binder booleans correctamente *@
                    @Html.CheckBoxFor(m => m.RememberMe, new { id = "rememberMe" })
                    <label for="rememberMe" style="display: inline; margin: 0;">Recuérdame</label>
                </div>

                @* Popover: al hacer click muestra mensaje y botón que redirige al formulario de contacto *@
                <a href="#" id="forgotPasswordPopover" role="button" tabindex="0" class="text-decoration-none">
                    ¿Olvidó su contraseña?
                </a>
            </div>

            <!-- Botón de login -->
            <button type="submit" class="btn-login">
                <i class="bi bi-box-arrow-in-right"></i> Ingresar
            </button>
        }

        <!-- Opciones adicionales -->
        <div class="divider">o</div>

        <!-- Pie del formulario -->
        <div class="footer-login">
            <p>¿No tienes cuenta? <a href="@contactUrl">Contacta al administrador</a></p>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script type="text/javascript">
        $(function () {
            // Opcional: focus inicial
            $('#Email').focus();

            // Inicializar popover de Bootstrap (usa el enlace contactUrl generado en Razor)
            var contactUrl = '@contactUrl';
            var forgotEl = document.getElementById('forgotPasswordPopover');

            if (forgotEl && window.bootstrap) {
                new bootstrap.Popover(forgotEl, {
                    html: true,
                    trigger: 'focus', // se cierra al perder foco / hacer click fuera
                    sanitize: false, // permitimos HTML simple en el contenido
                    content: function () {
                        return `<div>Si olvidaste tu contraseña ponte en contacto con un administrador.<div class="mt-2 text-end"><a class="btn btn-sm btn-primary" href="${contactUrl}">Contactar</a></div></div>`;
                    },
                    title: 'Recuperar contraseña'
                });
            }
        });
    </script>
}