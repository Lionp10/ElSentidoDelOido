@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<style>
    .access-denied-container {
        min-height: 60vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .access-denied-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(22, 37, 91, 0.1);
        padding: 3rem;
        max-width: 600px;
        text-align: center;
    }

    .access-denied-icon {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
    }

    .access-denied-icon i {
        font-size: 3rem;
        color: #dc2626;
    }

    .access-denied-title {
        font-size: 2rem;
        font-weight: 700;
        color: #16255b;
        margin-bottom: 1rem;
    }

    .access-denied-message {
        color: #6b7280;
        font-size: 1.1rem;
        margin-bottom: 2rem;
        line-height: 1.6;
    }

    .btn-back {
        background-color: #16255b;
        border-color: #16255b;
        color: white;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-back:hover {
        background-color: #1e3a8a;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(22, 37, 91, 0.3);
    }

    .btn-logout {
        background-color: transparent;
        border: 2px solid #d1d5db;
        color: #4b5563;
        font-weight: 600;
        padding: 0.75rem 2rem;
        border-radius: 8px;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        margin-left: 1rem;
    }

    .btn-logout:hover {
        background-color: #f3f4f6;
        border-color: #4b5563;
        color: #4b5563;
    }
</style>

<div class="access-denied-container">
    <div class="access-denied-card">
        <div class="access-denied-icon">
            <i class="bi bi-shield-exclamation"></i>
        </div>
        
        <h1 class="access-denied-title">Acceso Denegado</h1>
        
        <p class="access-denied-message">
            No tienes permisos suficientes para acceder a este recurso.<br />
            Esta sección está restringida únicamente para administradores del sistema.
        </p>

        <div class="mt-4">
            <a href="@Url.Action("Main", "Shift")" class="btn-back">
                <i class="bi bi-arrow-left"></i> Volver a Turnos
            </a>
            
            <form method="post" action="@Url.Action("Logout", "Auth")" style="display: inline;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-logout">
                    <i class="bi bi-box-arrow-right"></i> Cerrar Sesión
                </button>
            </form>
        </div>
    </div>
</div>
