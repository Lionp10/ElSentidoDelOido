<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - El Sentido del Oído</title>

    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ESDO.WebApplication.styles.css" asp-append-version="true" />

    <!-- Favicon -->
    <link rel="icon" type="image/jpg" href="~/images/Esdo.ico" />

    <style>
        :root {
            --color-primary: #16255b;
            --color-primary-dark: #0f1a42;
            --color-primary-light: #1f3a7a;
            --color-accent: #4a90e2;
            --color-accent-light: #6ba3eb;
            --color-neutral-light: #f8f9fa;
            --color-neutral-dark: #2d3748;
            --color-text-primary: #16255b;
            --color-text-secondary: #4a5568;
            --color-border: #e2e8f0;
            --color-success: #48bb78;
            --color-warning: #f6ad55;
            --color-error: #f56565;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen',
                'Ubuntu', 'Cantarell', 'Fira Sans', 'Droid Sans', 'Helvetica Neue',
                sans-serif;
            color: var(--color-text-secondary);
            background-color: var(--color-neutral-light);
            line-height: 1.6;
        }

        /* Header Top Section */
        .header-top {
            background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
            color: white;
            padding: 0.75rem 0;
            font-size: 0.875rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        }

        .header-top a {
            color: white;
            text-decoration: none;
            transition: all 0.3s ease;
        }

        .header-top a:hover {
            color: var(--color-accent-light);
            padding-left: 0.25rem;
        }

        .header-top-divider {
            border-right: 1px solid rgba(255, 255, 255, 0.2);
            margin: 0 1rem;
        }

        /* Navbar */
        .navbar {
            background-color: white !important;
            box-shadow: 0 2px 4px rgba(22, 37, 91, 0.08);
            padding: 1rem 0;
        }

        .navbar-brand img {
            transition: transform 0.3s ease;
        }

        .navbar-brand:hover img {
            transform: scale(1.05);
        }

        .nav-link {
            color: var(--color-text-secondary) !important;
            font-weight: 500;
            margin: 0 0.5rem;
            position: relative;
            transition: all 0.3s ease;
            padding: 0.5rem 0 !important;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background-color: var(--color-primary);
            transition: width 0.3s ease;
        }

        .nav-link:hover {
            color: var(--color-primary) !important;
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .nav-link.active {
            color: var(--color-primary) !important;
        }

        .nav-link.active::after {
            width: 100%;
        }

        /* Primary Button */
        .btn-primary {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
            font-weight: 600;
            padding: 0.6rem 1.5rem;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            background-color: var(--color-primary-dark);
            border-color: var(--color-primary-dark);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(22, 37, 91, 0.3);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        /* Outline Button */
        .btn-outline-primary {
            color: var(--color-primary);
            border-color: var(--color-primary);
            font-weight: 600;
        }

        .btn-outline-primary:hover {
            background-color: var(--color-primary);
            border-color: var(--color-primary);
            transform: translateY(-2px);
        }

        /* Hero Section */
        .hero-section {
            background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
            color: white;
            padding: 5rem 0;
            position: relative;
            overflow: hidden;
        }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 320"><path fill="rgba(255,255,255,0.05)" fill-opacity="1" d="M0,96L48,112C96,128,192,160,288,160C384,160,480,128,576,122.7C672,117,768,139,864,144C960,149,1056,139,1152,133.3C1248,128,1344,128,1392,128L1440,128L1440,320L1392,320C1344,320,1248,320,1152,320C1056,320,960,320,864,320C768,320,672,320,576,320C480,320,384,320,288,320C192,320,96,320,48,320L0,320Z"></path></svg>') no-repeat bottom;
            background-size: cover;
        }

        .hero-section > * {
            position: relative;
            z-index: 1;
        }

        .hero-title {
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 1rem;
        }

        .hero-subtitle {
            font-size: 1.1rem;
            opacity: 0.95;
            margin-bottom: 2rem;
            line-height: 1.8;
        }

        /* Section Headers */
        .section-header {
            margin-bottom: 3rem;
        }

        .section-title {
            color: var(--color-primary);
            font-weight: 700;
            font-size: 2rem;
            margin-bottom: 1rem;
        }

        .section-divider {
            background-color: var(--color-primary);
            height: 3px;
            width: 60px;
            border-radius: 2px;
            margin-bottom: 1.5rem;
        }

        .section-description {
            color: var(--color-text-secondary);
            font-size: 1.05rem;
            line-height: 1.8;
        }

        /* Cards */
        .service-card {
            background: white;
            border: 1px solid var(--color-border);
            border-radius: 12px;
            padding: 2rem;
            text-align: center;
            transition: all 0.3s ease;
            height: 100%;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 24px rgba(22, 37, 91, 0.15);
            border-color: var(--color-accent);
        }

        .service-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 1.5rem;
            background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-accent) 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2rem;
        }

        /* Form Styles */
        .form-group label {
            color: var(--color-text-primary);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .form-control {
            border: 1px solid var(--color-border);
            border-radius: 8px;
            padding: 0.75rem 1rem;
            transition: all 0.3s ease;
            font-size: 0.95rem;
        }

        .form-control:focus {
            border-color: var(--color-primary);
            box-shadow: 0 0 0 3px rgba(22, 37, 91, 0.1);
        }

        .form-control::placeholder {
            color: #cbd5e0;
        }

        .input-group-text {
            background-color: var(--color-neutral-light);
            border: 1px solid var(--color-border);
            color: var(--color-primary);
        }

        /* Modal Styles */
        .modal-header {
            background-color: var(--color-primary);
            color: white;
            border: none;
        }

        .modal-header .btn-close {
            filter: brightness(0) invert(1);
        }

        .modal-title {
            font-weight: 700;
        }

        /* Footer */
        footer {
            background-color: var(--color-primary);
            color: white;
            padding: 3rem 0 1rem;
            border-top: 4px solid var(--color-accent);
        }

        footer a {
            color: var(--color-accent-light);
            text-decoration: none;
            transition: all 0.3s ease;
        }

        footer a:hover {
            color: white;
        }

        .footer-section {
            margin-bottom: 2rem;
        }

        .footer-title {
            font-weight: 700;
            margin-bottom: 1rem;
            font-size: 1.1rem;
        }

        .footer-link {
            display: block;
            margin-bottom: 0.5rem;
            opacity: 0.9;
            transition: all 0.3s ease;
        }

        .footer-link:hover {
            opacity: 1;
            padding-left: 0.5rem;
        }

        .footer-bottom {
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 2rem;
            margin-top: 2rem;
            font-size: 0.9rem;
            opacity: 0.8;
        }

        /* Contact Section */
        .contact-item {
            margin-bottom: 1.5rem;
            display: flex;
            align-items: flex-start;
        }

        .contact-icon {
            color: var(--color-primary);
            font-size: 1.5rem;
            margin-right: 1rem;
            min-width: 24px;
        }

        .contact-info a {
            color: var(--color-primary);
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .contact-info a:hover {
            color: var(--color-accent);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .hero-title {
                font-size: 1.75rem;
            }

            .section-title {
                font-size: 1.5rem;
            }

            .hero-section {
                padding: 3rem 0;
            }

            .header-top-divider {
                display: none;
            }

            .nav-link {
                margin: 0.5rem 0;
            }
        }
    </style>
</head>

<body>
    <!-- Header Top -->
    <div class="header-top">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex flex-wrap">
                        <div class="d-flex align-items-center">
                            <a href="#" data-bs-toggle="modal" data-bs-target="#contactoModal">
                                <i class="bi bi-envelope"></i> Contáctanos
                            </a>
                        </div>
                        <span class="header-top-divider"></span>
                        <div class="d-flex align-items-center">
                            <a href='@Url.Content("https://www.google.com.ar/maps/search/el+sentido+del+o%C3%ADdo/@-33.1486347,-61.4730777,16z/data=!3m1!4b1?hl=es&authuser=4")' target="_blank">
                                <i class="bi bi-geo-alt"></i> Consultorios
                            </a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-md-end">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <a href="@Url.Action("Main", "Shift")">
                            <i class="bi bi-box-arrow-in-right"></i> Ir al sistema
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "Auth")">
                            <i class="bi bi-box-arrow-in-right"></i> Ingresar al sistema
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                <img src="~/images/LogoOido.webp" alt="Logo El Sentido del Oído" style="height: 50px;">
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active" href="#Inicio">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#Nosotros">Nosotros</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#Servicios">Servicios</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="https://iarargentina.com.ar/web/index.php" target="_blank">Audífonos</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="#Contacto">Contacto</a>
                    </li>
                </ul>
                <div class="ms-3">
                    <a href="@Url.Action("Index", "Shift")" class="btn btn-primary">
                        <i class="bi bi-ear"></i> Solicitar Turno
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container-fluid p-0">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row">
                <div class="col-md-3">
                    <div class="footer-section">
                        <div class="footer-title">Sobre Nosotros</div>
                        <p class="text-muted">Dedicados a cuidar tu audición con pasión y compromiso, ofreciendo servicios especializados en fonoaudiología.</p>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="footer-section">
                        <div class="footer-title">Servicios</div>
                        <a href="#Servicios" class="footer-link">Audiometría</a>
                        <a href="#Servicios" class="footer-link">Otoemisiones Acústicas</a>
                        <a href="#Servicios" class="footer-link">Audífonos</a>
                        <a href="#Servicios" class="footer-link">Rehabilitación Auditiva</a>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="footer-section">
                        <div class="footer-title">Contacto</div>
                        <div class="contact-item">                            
                            <a href="mailto:elsentidodeloido@gmail.com"><i class="bi bi-envelope"></i> elsentidodeloido@gmail.com</a>
                        </div>
                        <div class="contact-item">                            
                            <a href="https://wa.me/543464512604" target="_blank"><i class="bi bi-whatsapp"></i> +54 3464 512604</a>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="footer-section">
                        <div class="footer-title">Síguenos</div>
                        <a href="https://www.instagram.com/elsentidodeloido/" target="_blank" class="footer-link">
                            <i class="bi bi-instagram"></i> Instagram
                        </a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <p>&copy; @DateTime.Now.Year El Sentido del Oído. Todos los derechos reservados.</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <p>Desarrollado por <a href="https://www.linkedin.com/in/lionel-pesaresi-905a36238/" target="_blank">Lionel Pesaresi</a></p>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Smooth scrolling for navigation links
            const links = document.querySelectorAll('a[href^="#"]');
            links.forEach(link => {
                link.addEventListener('click', function (e) {
                    if (this.getAttribute('target') === '_blank') return;

                    const targetId = this.getAttribute('href').substring(1);
                    const targetElement = document.getElementById(targetId);

                    if (targetElement) {
                        e.preventDefault();
                        targetElement.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });

                        // Close navbar if open
                        const navbar = document.querySelector('.navbar-collapse');
                        if (navbar.classList.contains('show')) {
                            const toggler = document.querySelector('.navbar-toggler');
                            toggler.click();
                        }
                    }
                });
            });

            // Update active nav link on scroll
            const sections = document.querySelectorAll('section[id], div[id]');
            window.addEventListener('scroll', () => {
                let current = '';
                sections.forEach(section => {
                    const sectionTop = section.offsetTop;
                    if (window.pageYOffset >= sectionTop - 200) {
                        current = section.getAttribute('id');
                    }
                });

                document.querySelectorAll('.nav-link').forEach(link => {
                    link.classList.remove('active');
                    if (link.getAttribute('href').substring(1) === current) {
                        link.classList.add('active');
                    }
                });
            });
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
