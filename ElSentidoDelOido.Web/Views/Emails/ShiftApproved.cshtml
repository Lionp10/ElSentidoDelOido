@model ElSentidoDelOido.Web.Models.ShiftEmailViewModel
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Confirmación de turno</title>
</head>
<body style="font-family: Arial, Helvetica, sans-serif; background:#f6f8fb; margin:0; padding:16px; color:#374151;">
    <div style="max-width:700px; margin:0 auto;">
        <div style="background:#ffffff; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden;">
            <div style="padding:24px 20px; text-align:center; border-bottom:1px solid #f1f5f9;">
                @if (!string.IsNullOrEmpty(Model.LogoDataUri))
                {
                    <img src="@Model.LogoDataUri"
                         alt="El Sentido del Oído"
                         style="height:75px; display:block; margin:0 auto 8px;"
                         width="100" />
                }
                else
                {
                    <h2 style="color:#16255b; margin:0; font-size:24px;">El Sentido del Oído</h2>
                }
                <h2 style="color:#16255b; margin:6px 0 0; font-size:20px;">Confirmación de turno</h2>
                <p style="color:#6b7280; margin:6px 0 0; font-size:13px;">Gracias por elegirnos. A continuación encontrarás los detalles de tu turno.</p>
            </div>

            <div style="padding:20px;">
                <table role="presentation" width="100%" style="border-collapse:collapse;">
                    <tr>
                        <td style="padding:8px 0; vertical-align:top; width:30%; color:#6b7280; font-weight:600;">Paciente</td>
                        <td style="padding:8px 0;">@Html.Raw(Model.PatientName)</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0; color:#6b7280; font-weight:600;">Fecha</td>
                        <td style="padding:8px 0;">@Html.Raw(Model.Date)</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0; color:#6b7280; font-weight:600;">Hora</td>
                        <td style="padding:8px 0;">@Html.Raw(Model.Hour)</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0; color:#6b7280; font-weight:600;">Tipo</td>
                        <td style="padding:8px 0;">@Html.Raw(Model.ShiftType)</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0; color:#6b7280; font-weight:600;">Profesional</td>
                        <td style="padding:8px 0;">@Html.Raw(Model.Professional)</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0; color:#6b7280; font-weight:600;">Dirección</td>
                        <td style="padding:8px 0;">@Html.Raw(Model.ClinicAddress)</td>
                    </tr>
                    <tr>
                        <td style="padding:8px 0; color:#6b7280; font-weight:600;">Nota</td>
                        <td style="padding:8px 0;">@Html.Raw(Model.PatientNote)</td>
                    </tr>
                </table>

                <div style="margin-top:18px; padding:12px; background:#f8fafc; border-radius:6px; border:1px solid #eef2f7;">
                    <p style="margin:0; color:#6b7280;">Por favor, llega 15 minutos antes del horario indicado. Si necesitas reprogramar, contáctanos con anticipación.</p>
                </div>

                <div style="text-align:center; margin-top:18px;">
                    <a href="@Model.BaseUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       style="display:inline-block; padding:10px 20px; background:#16255b; color:#fff; text-decoration:none; border-radius:6px;">
                        Visitar sitio
                    </a>
                </div>

                <hr style="border:none; border-top:1px solid #f1f5f9; margin:18px 0;" />

                <p style="font-size:12px; color:#9ca3af; text-align:center; margin:0;">
                    Si no solicitaste este turno, contáctanos a <a href="mailto:contacto@elsentidodeloido.com" style="color:#16255b; text-decoration:none;">contacto@elsentidodeloido.com</a>
                </p>
            </div>
        </div>
    </div>
</body>
</html>