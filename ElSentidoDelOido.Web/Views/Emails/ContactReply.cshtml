@model ElSentidoDelOido.Web.Models.ContactReplyEmailViewModel
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Respuesta - El Sentido del Oído</title>
</head>
<body style="font-family: Arial, Helvetica, sans-serif; background:#f6f8fb; margin:0; padding:16px; color:#374151;">
    <div style="max-width:700px; margin:0 auto;">
        <div style="background:#ffffff; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden;">
            <div style="padding:24px 20px; text-align:center; border-bottom:1px solid #f1f5f9;">
                @if (!string.IsNullOrEmpty(Model.LogoDataUri))
                {
                    <img src="@Model.LogoDataUri"
                         alt="El Sentido del Oído"
                         style="height:75px; display:block; margin:0 auto 8px;"
                         width="100" />
                }
                else
                {
                    <h2 style="color:#16255b; margin:0; font-size:24px;">El Sentido del Oído</h2>
                }
                <h2 style="color:#16255b; margin:6px 0 0; font-size:20px;">Respuesta a tu mensaje</h2>
                <p style="color:#6b7280; margin:6px 0 0; font-size:13px;">Gracias por contactarnos. Te enviamos nuestra respuesta.</p>
            </div>

            <div style="padding:20px;">
                <p style="margin:0 0 12px;">Hola <strong>@Html.Raw(Model.ContactName)</strong>,</p>
                
                <p style="color:#6b7280; margin:0 0 16px;">Gracias por tu mensaje. Respondimos tu consulta el <strong>@Html.Raw(Model.ReplyDate)</strong>.</p>

                @if (!string.IsNullOrWhiteSpace(Model.OriginalMessage))
                {
                    <div style="margin:18px 0; padding:12px; background:#f9fafb; border-left:4px solid #e5e7eb; border-radius:4px;">
                        <p style="margin:0 0 6px; color:#6b7280; font-size:12px; font-weight:600; text-transform:uppercase;">Tu mensaje:</p>
                        <p style="margin:0; color:#4b5563; font-size:14px; line-height:1.5;">@Html.Raw(Model.OriginalMessage)</p>
                    </div>
                }

                <div style="margin:18px 0; padding:14px; background:#f0f9ff; border-left:4px solid #0ea5e9; border-radius:4px;">
                    <p style="margin:0 0 6px; color:#0369a1; font-size:12px; font-weight:600; text-transform:uppercase;">Nuestra respuesta:</p>
                    <p style="margin:0; color:#0c4a6e; font-size:14px; line-height:1.6;">@Html.Raw(Model.ReplyMessage)</p>
                </div>

                <div style="margin-top:18px; padding:12px; background:#f8fafc; border-radius:6px; border:1px solid #eef2f7;">
                    <p style="margin:0; color:#6b7280; font-size:14px;">Si necesitás más información, no dudes en responder a este correo o contactarnos directamente.</p>
                </div>

                <div style="text-align:center; margin-top:18px;">
                    <a href="@Model.BaseUrl"
                       target="_blank"
                       rel="noopener noreferrer"
                       style="display:inline-block; padding:10px 20px; background:#16255b; color:#fff; text-decoration:none; border-radius:6px; font-weight:600;">
                        Visitar sitio web
                    </a>
                </div>

                <hr style="border:none; border-top:1px solid #f1f5f9; margin:18px 0;" />

                <div style="text-align:center;">
                    <p style="margin:0; color:#374151; font-weight:600;">Saludos cordiales,</p>
                    <p style="margin:4px 0 0; color:#16255b; font-weight:700;">El Sentido del Oído</p>
                </div>

                <div style="margin-top:12px; text-align:center;">
                    <p style="font-size:12px; color:#9ca3af; margin:4px 0;">
                        <a href="mailto:contacto@elsentidodeloido.com" style="color:#16255b; text-decoration:none;">contacto@elsentidodeloido.com</a>
                    </p>
                    <p style="font-size:11px; color:#9ca3af; margin:4px 0;">
                        Belgrano 1212, Arequito, Santa Fe
                    </p>
                </div>
            </div>
        </div>
    </div>
</body>
</html>